# ─────────────────────────────────────────────────────────────
# Estos bloques NO vienen con iNiR por defecto. Agrégalos a tu
# ~/.config/niri/config.kdl a mano, en el nivel raíz del archivo.
# ─────────────────────────────────────────────────────────────

# 1. Evita un crash silencioso de arranque de iNiR (bug del script
#    apply_niri_app_environment: si NINGUNA variable de entorno de
#    niri está configurada, la función retorna exit 1 sin imprimir
#    nada, y con `set -e` mata todo el servicio). Poner cualquier
#    valor aquí evita el bug, y de paso corre apps Electron nativas
#    en Wayland en vez de XWayland.
environment {
    ELECTRON_OZONE_PLATFORM_HINT "wayland"
}

# 2. Hace que el fondo desenfocado del overview (Mod+Space en iNiR,
#    o el overview nativo de niri con toggle-overview) se muestre
#    SOLO dentro del overview, en vez de visible todo el tiempo en
#    el escritorio normal. Cubre ambos estilos de panel de iNiR:
#    "ii" (namespace iiBackdrop) y "waffle" (namespace wBackdrop).
layer-rule {
    match namespace="^quickshell:(iiBackdrop|wBackdrop)$"
    place-within-backdrop true
}

# 3. iNiR NO bindea el overview nativo del compositor (distinto del
#    overview propio de iNiR que abre Mod+Space). Agrégalo a mano:
binds {
    Super+Tab { toggle-overview; }
}
