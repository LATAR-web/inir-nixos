#!/usr/bin/env bash
COLORS_JSON="$HOME/.local/state/quickshell/user/generated/colors.json"
META_JSON="$HOME/.local/state/quickshell/user/generated/theme-meta.json"
NIRI_CONFIG_PY="$HOME/.config/quickshell/inir/scripts/niri-config.py"
SHELL_CONFIG_FILE="$HOME/.config/illogical-impulse/config.json"
PYTHON="python3"

[[ -f "$COLORS_JSON" ]] || exit 0

primary=$("$PYTHON" -c "import json; print(json.load(open('$COLORS_JSON'))['primary'])")
secondary=$("$PYTHON" -c "import json; print(json.load(open('$COLORS_JSON'))['secondary'])")

"$PYTHON" "$NIRI_CONFIG_PY" set layout focus-ring.active-color "$primary"
"$PYTHON" "$NIRI_CONFIG_PY" set layout focus-ring.inactive-color "$secondary"

if [[ -f "$META_JSON" && -f "$SHELL_CONFIG_FILE" ]]; then
    wallpaper_path=$("$PYTHON" -c "import json; print(json.load(open('$META_JSON')).get('source_path',''))")
    if [[ -n "$wallpaper_path" ]]; then
        lockfile="$SHELL_CONFIG_FILE.lock"
        (
            flock -w 5 200 || exit 1
            jq --arg path "$wallpaper_path" '.background.wallpaperPath = $path' "$SHELL_CONFIG_FILE" > "$SHELL_CONFIG_FILE.tmp" && \
                mv "$SHELL_CONFIG_FILE.tmp" "$SHELL_CONFIG_FILE"
        ) 200>"$lockfile"
    fi
fi
