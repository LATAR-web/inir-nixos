#!/usr/bin/env bash
set -Eeuo pipefail

COLORS_JSON="$HOME/.local/state/quickshell/user/generated/colors.json"
META_JSON="$HOME/.local/state/quickshell/user/generated/theme-meta.json"
GENERATED_DIR="$HOME/.local/state/quickshell/user/generated"
SHELL_CONFIG_FILE="$HOME/.config/illogical-impulse/config.json"
NIRI_CONFIG_FILE="$HOME/.config/niri/config.kdl"
ALACRITTY_THEME_FILE="$HOME/.config/alacritty/theme.toml"
PYTHON="python3"

find_niri_config_py() {
    if [[ -f "$HOME/.config/quickshell/inir/scripts/niri-config.py" ]]; then
        echo "$HOME/.config/quickshell/inir/scripts/niri-config.py"
    elif [[ -f "/run/current-system/sw/share/quickshell/inir/scripts/niri-config.py" ]]; then
        echo "/run/current-system/sw/share/quickshell/inir/scripts/niri-config.py"
    else
        echo ""
    fi
}

seed_default_colors_if_missing() {
    if [[ ! -f "$COLORS_JSON" ]]; then
        mkdir -p "$GENERATED_DIR"
        cat > "$COLORS_JSON" <<'EOF'
{
  "primary": "#7aa2f7",
  "on_primary": "#1d202f",
  "primary_container": "#2ac3de",
  "on_primary_container": "#15161e",
  "secondary": "#bb9af7",
  "on_secondary": "#1d202f",
  "surface": "#1a1b26",
  "on_surface": "#c0caf5",
  "background": "#16161e",
  "on_background": "#c0caf5",
  "outline": "#565f89",
  "dark": true
}
EOF
    fi
}

sync_once() {
    seed_default_colors_if_missing

    command -v "$PYTHON" >/dev/null 2>&1 || {
        echo "niri-sync-colors: python3 not found (skipping sync)" >&2
        return 1
    }

    local niri_config_py
    niri_config_py="$(find_niri_config_py)"

    # Execute Python engine for atomic file updates (Niri KDL fallback, Alacritty theme, wallpaper metadata)
    local py_out
    py_out="$("$PYTHON" -c '
import json, os, sys, re, colorsys

colors_file = sys.argv[1]
meta_file = sys.argv[2]
shell_conf_file = sys.argv[3]
niri_kdl_file = sys.argv[4]
alacritty_theme_file = sys.argv[5]
niri_config_py = sys.argv[6]

try:
    with open(colors_file, "r", encoding="utf-8") as f:
        data = json.load(f)
except Exception:
    sys.exit(0)

# Extract palette data (supporting flat or nested formats from matugen/materialyoucolor)
c = data.get("colors", data) if isinstance(data.get("colors"), dict) else data
if "dark" in data and isinstance(data["dark"], dict):
    c = data["dark"]

def get_color(key, default):
    val = c.get(key) or data.get(key) or default
    if isinstance(val, str):
        val = val.strip()
        if not val.startswith("#") and re.match(r"^[0-9a-fA-F]{6}$", val):
            val = "#" + val
    return val

primary = get_color("primary", "#7aa2f7")
secondary = get_color("secondary", get_color("outline", "#bb9af7"))
surface = get_color("surface", get_color("background", "#1a1b26"))
on_surface = get_color("on_surface", "#c0caf5")
is_dark = data.get("dark", True)
if isinstance(is_dark, str):
    is_dark = is_dark.lower() in ("true", "1", "yes", "dark")

# 1. Update Niri focus-ring colors
niri_updated = False
if niri_config_py and os.path.isfile(niri_config_py) and os.access(niri_config_py, os.X_OK):
    ret1 = os.system(f"{sys.executable} \"{niri_config_py}\" set layout focus-ring.active-color \"{primary}\" >/dev/null 2>&1")
    ret2 = os.system(f"{sys.executable} \"{niri_config_py}\" set layout focus-ring.inactive-color \"{secondary}\" >/dev/null 2>&1")
    if ret1 == 0 and ret2 == 0:
        niri_updated = True

# Fallback: direct atomic update of config.kdl
if not niri_updated and os.path.exists(niri_kdl_file):
    try:
        with open(niri_kdl_file, "r", encoding="utf-8") as f:
            kdl = f.read()
        kdl_new = re.sub(r"(active-color\s+)\"[^\"]+\"", lambda m: f"{m.group(1)}\"{primary}\"", kdl)
        kdl_new = re.sub(r"(inactive-color\s+)\"[^\"]+\"", lambda m: f"{m.group(1)}\"{secondary}\"", kdl_new)
        if kdl_new != kdl:
            tmp = f"{niri_kdl_file}.tmp.{os.getpid()}"
            with open(tmp, "w", encoding="utf-8") as f:
                f.write(kdl_new)
            os.replace(tmp, niri_kdl_file)
            niri_updated = True
    except Exception:
        pass

# 2. Sync wallpaper path into iNiR shell config
if os.path.exists(meta_file):
    try:
        with open(meta_file, "r", encoding="utf-8") as f:
            meta = json.load(f)
        wp = meta.get("source_path")
        if wp and os.path.exists(wp):
            if os.path.exists(shell_conf_file):
                with open(shell_conf_file, "r", encoding="utf-8") as f:
                    conf = json.load(f)
            else:
                conf = {}
                os.makedirs(os.path.dirname(shell_conf_file), exist_ok=True)
            if not isinstance(conf.get("background"), dict):
                conf["background"] = {}
            if conf["background"].get("wallpaperPath") != wp:
                conf["background"]["wallpaperPath"] = wp
                tmp = f"{shell_conf_file}.tmp.{os.getpid()}"
                with open(tmp, "w", encoding="utf-8") as f:
                    json.dump(conf, f, indent=2)
                os.replace(tmp, shell_conf_file)
    except Exception:
        pass

# 3. Generate dynamic Alacritty theme
try:
    os.makedirs(os.path.dirname(alacritty_theme_file), exist_ok=True)
    bg = surface if surface else ("#16161e" if is_dark else "#f5f5f7")
    fg = on_surface if on_surface else ("#c0caf5" if is_dark else "#1d202f")
    alacritty_toml = f"""# Auto-generated by niri-sync-colors from Material You theme
[colors.primary]
background = "{bg}"
foreground = "{fg}"

[colors.cursor]
text = "{bg}"
cursor = "{primary}"

[colors.selection]
text = "{fg}"
background = "{secondary}"

[colors.normal]
black = "{bg}"
red = "#f7768e"
green = "#9ece6a"
yellow = "#e0af68"
blue = "{primary}"
magenta = "{secondary}"
cyan = "#7dcfff"
white = "{fg}"

[colors.bright]
black = "#565f89"
red = "#f7768e"
green = "#9ece6a"
yellow = "#e0af68"
blue = "{primary}"
magenta = "{secondary}"
cyan = "#7dcfff"
white = "#ffffff"
"""
    tmp = f"{alacritty_theme_file}.tmp.{os.getpid()}"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(alacritty_toml)
    os.replace(tmp, alacritty_theme_file)
except Exception:
    pass

# 4. Compute GNOME accent color from primary hue
ACCENTS = {
    "blue": (53, 132, 228),
    "teal": (38, 162, 105),
    "green": (46, 194, 126),
    "yellow": (246, 211, 45),
    "orange": (255, 120, 0),
    "red": (224, 27, 36),
    "pink": (213, 97, 151),
    "purple": (145, 65, 172),
}

best_accent = "blue"
try:
    h_str = primary.lstrip("#")
    if len(h_str) == 3:
        h_str = "".join(x*2 for x in h_str)
    r, g, b = tuple(int(h_str[i:i+2], 16) for i in (0, 2, 4))
    h, s, v = colorsys.rgb_to_hsv(r/255.0, g/255.0, b/255.0)
    if s < 0.15:
        best_accent = "slate"
    else:
        best_diff = float("inf")
        for name, rgb in ACCENTS.items():
            ah, as_, av = colorsys.rgb_to_hsv(rgb[0]/255.0, rgb[1]/255.0, rgb[2]/255.0)
            diff = abs(h - ah)
            if diff > 0.5:
                diff = 1.0 - diff
            if diff < best_diff:
                best_diff = diff
                best_accent = name
except Exception:
    best_accent = "blue"

print(f"ACCENT={best_accent}")
print(f"DARK={1 if is_dark else 0}")
print(f"PRIMARY={primary}")
print(f"SECONDARY={secondary}")
' "$COLORS_JSON" "$META_JSON" "$SHELL_CONFIG_FILE" "$NIRI_CONFIG_FILE" "$ALACRITTY_THEME_FILE" "$niri_config_py" 2>/dev/null || true)"

    # Parse Python output
    local ACCENT="blue" DARK=1 PRIMARY="" SECONDARY=""
    if [[ -n "$py_out" ]]; then
        eval "$py_out" 2>/dev/null || true
    fi

    # Trigger live reload of Niri configuration for instant visual feedback
    if command -v niri >/dev/null 2>&1; then
        niri msg action reload-config 2>/dev/null || true
    fi

    # Synchronize GNOME / GTK accent color and color scheme if session bus is active
    if command -v gsettings >/dev/null 2>&1 && [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
        if gsettings list-keys org.gnome.desktop.interface 2>/dev/null | grep -q "^accent-color$"; then
            gsettings set org.gnome.desktop.interface accent-color "$ACCENT" 2>/dev/null || true
        fi
        if [[ "$DARK" -eq 1 ]]; then
            gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' 2>/dev/null || true
        else
            gsettings set org.gnome.desktop.interface color-scheme 'prefer-light' 2>/dev/null || true
        fi
    fi
}

poll_loop() {
    # Fallback watcher for systems without inotify-tools: cheap polling,
    # keeps the service alive until iNiR is (re)installed.
    local last_mts=""
    local cur_mts=""
    sync_once || true
    while true; do
        if [[ -d "$GENERATED_DIR" ]]; then
            cur_mts="$(stat -c '%Y:%s:%n' "$GENERATED_DIR"/* 2>/dev/null | sha256sum | cut -d' ' -f1 || true)"
            if [[ -n "$cur_mts" && "$cur_mts" != "$last_mts" ]]; then
                sync_once || true
                last_mts="$cur_mts"
            fi
        fi
        sleep 3
    done
}

case "${1:-}" in
    "")
        sync_once || true
        ;;

    --watch)
        # Singleton lock to ensure only one watcher runs per user session
        LOCK_FILE="${XDG_RUNTIME_DIR:-/tmp}/niri-sync-colors.lock"
        if command -v flock >/dev/null 2>&1; then
            exec 200>"$LOCK_FILE"
            if ! flock -n 200; then
                exit 0
            fi
        fi

        # NEVER exit on missing prerequisites: this service runs from login
        # and iNiR may not be installed yet (first boot before the rebuild).
        # Wait and pick things up as soon as they appear.
        if ! command -v inotifywait >/dev/null 2>&1; then
            echo "niri-sync-colors: inotifywait not found yet — using polling fallback (install inir to get inotify-tools)" >&2
            poll_loop
        fi

        # Initial synchronization upon startup
        sync_once || true

        while true; do
            while [[ ! -d "$GENERATED_DIR" ]]; do
                sleep 2
            done

            sync_once || true

            inotifywait -m \
                -e close_write,moved_to \
                --format '%f' \
                "$GENERATED_DIR" 2>/dev/null |
            while read -r file; do
                case "$file" in
                    colors.json|theme-meta.json)
                        sync_once || echo "niri-sync-colors: sync failed, will retry on next event" >&2
                        ;;
                esac
            done
            sleep 1
        done
        ;;

    --help|-h)
        cat <<'HELP'
Usage:
  niri-sync-colors
  niri-sync-colors --watch

Synchronizes iNiR/Quickshell Material You colors with Niri, Alacritty,
GTK/GNOME desktop accent, and keeps the wallpaper path in sync.
HELP
        ;;

    *)
        echo "Usage: niri-sync-colors [--watch]" >&2
        exit 2
        ;;
esac
