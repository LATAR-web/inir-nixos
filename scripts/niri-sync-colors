#!/usr/bin/env bash
set -Eeuo pipefail

COLORS_JSON="$HOME/.local/state/quickshell/user/generated/colors.json"
META_JSON="$HOME/.local/state/quickshell/user/generated/theme-meta.json"
GENERATED_DIR="$HOME/.local/state/quickshell/user/generated"
SHELL_CONFIG_FILE="$HOME/.config/illogical-impulse/config.json"
PYTHON="python3"

find_niri_config_py() {
    if [[ -f "$HOME/.config/quickshell/inir/scripts/niri-config.py" ]]; then
        echo "$HOME/.config/quickshell/inir/scripts/niri-config.py"
    elif [[ -f "/run/current-system/sw/share/quickshell/inir/scripts/niri-config.py" ]]; then
        echo "/run/current-system/sw/share/quickshell/inir/scripts/niri-config.py"
    else
        echo ""
    fi
}

sync_once() {
    [[ -f "$COLORS_JSON" ]] || return 0

    command -v "$PYTHON" >/dev/null 2>&1 || {
        echo "niri-sync-colors: python3 not found (skipping sync)" >&2
        return 1
    }

    local niri_config_py
    niri_config_py="$(find_niri_config_py)"

    [[ -n "$niri_config_py" ]] || {
        echo "niri-sync-colors: niri-config.py not found (skipping sync)" >&2
        return 1
    }

    # Extract primary and secondary colors
    local primary=""
    local secondary=""

    if command -v jq >/dev/null 2>&1; then
        primary="$(jq -er '.primary | strings' "$COLORS_JSON" 2>/dev/null || true)"
        secondary="$(jq -er '.secondary | strings' "$COLORS_JSON" 2>/dev/null || true)"
    fi

    if [[ -z "$primary" || -z "$secondary" ]]; then
        read -r primary secondary < <("$PYTHON" -c '
import json, sys
try:
    with open(sys.argv[1]) as f:
        d = json.load(f)
    print(d.get("primary", ""), d.get("secondary", ""))
except Exception:
    print("", "")
' "$COLORS_JSON")
    fi

    if [[ -n "$primary" && -n "$secondary" ]]; then
        "$PYTHON" "$niri_config_py" \
            set layout focus-ring.active-color "$primary" 2>/dev/null || true

        "$PYTHON" "$niri_config_py" \
            set layout focus-ring.inactive-color "$secondary" 2>/dev/null || true
    fi

    # Sync wallpaper path into iNiR shell config if metadata exists
    if [[ -f "$META_JSON" && -f "$SHELL_CONFIG_FILE" ]]; then
        "$PYTHON" -c '
import json, sys, os

meta_file = sys.argv[1]
conf_file = sys.argv[2]

try:
    with open(meta_file) as f:
        meta = json.load(f)
    wp = meta.get("source_path")
    if not wp or not os.path.exists(wp):
        sys.exit(0)

    with open(conf_file) as f:
        conf = json.load(f)

    if not isinstance(conf.get("background"), dict):
        conf["background"] = {}

    if conf["background"].get("wallpaperPath") != wp:
        conf["background"]["wallpaperPath"] = wp
        tmp = f"{conf_file}.tmp.{os.getpid()}"
        with open(tmp, "w") as f:
            json.dump(conf, f, indent=2)
        os.replace(tmp, conf_file)
except Exception:
    sys.exit(0)
' "$META_JSON" "$SHELL_CONFIG_FILE" 2>/dev/null || true
    fi
}

poll_loop() {
    # Fallback watcher for systems without inotify-tools: cheap polling,
    # keeps the service alive until iNiR is (re)installed.
    local last_mts=""
    local cur_mts=""
    while true; do
        if [[ -d "$GENERATED_DIR" ]]; then
            cur_mts="$(stat -c '%Y:%n' "$GENERATED_DIR"/* 2>/dev/null | sort | sha256sum | cut -d' ' -f1 || true)"
            if [[ -n "$cur_mts" && "$cur_mts" != "$last_mts" ]]; then
                sync_once || true
                last_mts="$cur_mts"
            fi
        fi
        sleep 5
    done
}

case "${1:-}" in
    "")
        sync_once || true
        ;;

    --watch)
        # NEVER exit on missing prerequisites: this service runs from login
        # and iNiR may not be installed yet (first boot before the rebuild).
        # Wait and pick things up as soon as they appear.
        if ! command -v inotifywait >/dev/null 2>&1; then
            echo "niri-sync-colors: inotifywait not found yet — using polling fallback (install inir to get inotify-tools)" >&2
            poll_loop
        fi

        while [[ ! -d "$GENERATED_DIR" ]]; do
            sleep 2
        done

        sync_once || true

        inotifywait -m \
            -e close_write,moved_to \
            --format '%f' \
            "$GENERATED_DIR" |
        while read -r file; do
            case "$file" in
                colors.json|theme-meta.json)
                    sync_once || echo "niri-sync-colors: sync failed, will retry on next event" >&2
                    ;;
            esac
        done
        ;;

    --help|-h)
        cat <<'HELP'
Usage:
  niri-sync-colors
  niri-sync-colors --watch

Synchronizes iNiR/Quickshell colors with Niri and keeps
the iNiR wallpaper path in sync with theme metadata.
HELP
        ;;

    *)
        echo "Usage: niri-sync-colors [--watch]" >&2
        exit 2
        ;;
esac
